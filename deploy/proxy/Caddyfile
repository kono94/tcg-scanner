{
	# Let's Encrypt account e-mail (expiry notices).
	email {$ACME_EMAIL}
}

scanner.lwenstrom.net {
	encode zstd gzip
	reverse_proxy scanner:80
}

# TFT: its internal nginx (`tft-nginx`, compose profile `proxied`) joins the `web` network
# and routes /, /api, /ws and /grafana/ itself.
tft.lwenstrom.net {
	encode zstd gzip
	reverse_proxy tft-nginx:80
}
