# Plain HTTP inside the `web` network; the shared proxy terminates HTTPS.
{
	auto_https off
	admin off
	servers {
		# Keep the visitor address the shared proxy forwards (rate limiting in the upload service).
		trusted_proxies static private_ranges
	}
}

:80 {
	# Cross-origin isolation enables WASM threads (same as the dev server). Everything is same-origin.
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		Cross-Origin-Resource-Policy same-origin
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		# Default: revalidate (cheap 304s). `?` only sets it when nothing more specific did.
		?Cache-Control no-cache
	}
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Catalog reference thumbnails, shared across releases (scripts/release/build_ref_thumbnails.py).
	handle_path /refs/* {
		root * /srv/refs
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Training uploads (deploy/scanner/upload-service): captures and corrections, when the visitor allows it.
	handle /api/* {
		request_body {
			max_size 25MB
		}
		header Cache-Control no-store
		reverse_proxy uploads:8080
	}

	handle {
		root * /srv/current
		file_server
	}
}
